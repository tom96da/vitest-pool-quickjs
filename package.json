{
  "name": "vitest-pool-quickjs",
  "version": "1.0.0",
  "description": "A Vitest pool that runs test files in QuickJS.",
  "keywords": [
    "quickjs",
    "test",
    "vitest",
    "vitest-pool"
  ],
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/vitest-pool-quickjs.git"
  },
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
