{
  "name": "vitest-pool-quickjs",
  "version": "1.0.0",
  "description": "A Vitest pool that runs test files in QuickJS.",
  "keywords": [
    "quickjs",
    "test",
    "vitest",
    "vitest-pool"
  ],
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/vitest-pool-quickjs.git"
  },
  "type": "module",
  "scripts": {
    "pretest": "pnpm build",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "pathe": "^2.0.3",
    "quickjs-emscripten": "^0.32.0",
    "rolldown": "~1.2.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "ts-dedent": "^2.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
